{
  "name": "senai-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-seed"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "^22.0.0",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
